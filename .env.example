# Supabase Local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (substitua pela chave anônima local do supabase)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (substitua pela service role key local)

# Configuração de Ambiente Local / Offline
# Se verdadeiro, os gateways usarão dados falsos em vez de fazer requisições externas
VITE_USE_MOCKS=true

# Gateways (Deixe vazio ou use qualquer valor se VITE_USE_MOCKS for true)
ALPHA_PUBLIC_KEY=mock_alpha_pub
ALPHA_SECRET_KEY=mock_alpha_sec

BLACKCAT_PUBLIC_KEY=mock_blackcat_pub
BLACKCAT_SECRET_KEY=mock_blackcat_sec

FREEPAY_PUBLIC_KEY=mock_freepay_pub
FREEPAY_SECRET_KEY=mock_freepay_sec

KLIVO_PUBLIC_KEY=mock_klivo_pub
KLIVO_SECRET_KEY=mock_klivo_sec

PUSHCUT_API_KEY=mock_pushcut_key
